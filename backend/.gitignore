# =========================
# Node / Backend .gitignore
# =========================

# Dependencies
node_modules/
bower_components/

# Env & secrets
.env
.env.*
!.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Build / compiled
dist/
build/
.cache/
.next/
out/
coverage/
.nyc_output/
.vscode-test/

# Temporary files
tmp/
temp/
*.tmp

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp

# Uploads (if generated runtime — optional)
uploads/

# Docker
docker-data/
